      "unit": "share",
      "source": "0x14074042C mov rax,0x3FE0000000000000 and 0x140740436 mov [rbx+0x38],rax; the field is CaSharePercent; english.json CaShare.Help says 'Default: 50%'"
    },
    {
      "name": "role weight group total",
      "group": "rating",
      "value": 100,
      "unit": "percent",
      "source": "0x140741DE0 requires each of the three group totals to equal 0x64 (100)"
    },
    {
      "name": "role weights field map",
      "group": "rating",
      "value": "+0x10 map, +0x18 ladder, +0x20 key, +0x28 preferable, +0x30 avoid, +0x38 CA share",
      "unit": "offsets",
      "source": "accessors 0x140740090/0A0 (+0x20), 0x1407400B0/0C0 (+0x28), 0x1407400D0/0E0 (+0x30), 0x1407400F0/100 (+0x18), 0x140740110/120 (+0x38); verified with native_bytes_show at 0x140740090 and native_function_callers_list"
    },
    {
      "name": "role weights default stores",
      "group": "rating",
      "value": "16.0 @0x140740455 +0x20; 4.0 @0x1407403FB +0x28; 3.0 @0x140740410 +0x30; 0.5 @0x14074042C +0x38",
      "unit": "addresses",
      "source": "native_bytes_show 0x1407403F0 (176 bytes): 48 B9 imm64 + 48 89 4B disp8 for 4.0/3.0/0.5, 48 B8 imm64 + 48 89 43 20 for 16.0"
    },
    {
      "name": "role weights validator",
      "group": "rating",
      "value": "0x1407404C0",
      "unit": "address",
      "source": "Ghidra slice dump tools/ghidra_out/0x1407404c0.c plus native_function_pseudocode; six conditions (see below)"
    },
    {
      "name": "role weights sum rule",
      "group": "rating",
      "value": true,
      "unit": "bool",
      "source": "0x1407404C0 compares +0x20 + +0x28 + +0x30 <= 0.0 and returns 0 (reject), so the three weights must sum above zero"
    },
    {
      "name": "role weights negative rule",
      "group": "rating",
      "value": true,
      "unit": "bool",
      "source": "0x1407404C0 compares +0x20, +0x28 and +0x30 against 0.0 and rejects any negative weight"
    },
    {
      "name": "CA share validated",
      "group": "rating",
      "value": false,
      "unit": "bool",
      "source": "0x1407404C0 never reads +0x38; an out-of-range CaShare is accepted by the original"
    },
    {
      "name": "avoid weight in the displayed rating",
      "group": "rating",
      "value": false,
      "unit": "bool",
      "source": "rolesAndDuties.json DutiesAttributes carry only KeyAttribute true/false (no avoid group); 0.5*158/200+0.5*0.76 = 77.49 exactly, so no avoid term acts on the header"
    },
    {
      "name": "role weights loader",
      "group": "rating",
      "value": "FMRTE_ROLE_WEIGHTS",
      "unit": "env var",
      "source": "ratings.load_role_weights: reads the original's Ratings/rolesAndDuties.json, validates it with the 0x1407404C0 rules, falls back to the compiled defaults"
    },
    {
      "name": "role definitions completeness validator",
      "group": "rating",
      "value": "0x1407406C0",
      "unit": "address",
      "source": "Ghidra 12.1.4 on a 64 KB .text slice at 0x140740000; 0x1407404C0 calls it before it reads any weight"
    },
    {
      "name": "role table must cover every position",
      "group": "rating",
      "value": true,
      "unit": "bool",
      "source": "0x1407406C0 walks the position enum and returns 0 when a position has no entry in the +0x10 dictionary"
    },
    {
      "name": "duty attributes must all resolve",
      "group": "rating",
      "value": true,
      "unit": "bool",
      "source": "0x1407406C0 returns 0 when a duty names an attribute the global attribute dictionary does not resolve"
    },
    {
      "name": "roles dictionary slot",
      "group": "rating",
      "value": "+0x10",
      "unit": "offset",
      "source": "getter 0x140740070 is 'return [rcx+0x10]'; 0x140740340 stores the builder 0x140741FA0's +0x10 there"
    },
    {
      "name": "penalty ladder is copied per instance",
      "group": "rating",
      "value": true,
      "unit": "bool",
      "source": "0x140741F50 allocates 0x14 elements and memcpy 0x50 bytes from 0x14517BB38, so each object owns a mutable copy"
    },
